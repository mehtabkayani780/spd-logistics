// ============================================
// SPD LOGISTICS — Database Schema
// ============================================
// 18 tables with proper relationships, indexes,
// constraints, and timestamps.
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  username    String?   @unique
  password    String
  name        String
  phone       String?
  role        String    @default("STAFF")
  status      String    @default("ACTIVE")
  avatar      String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditLogs           AuditLog[]
  cashBookTransactions CashBookTransaction[] @relation("CreatedBy")
  consignments        Consignment[]          @relation("CreatedBy")
  payments            Payment[]              @relation("CreatedBy")
  notifications       Notification[]
  excelImports        ExcelImport[]
  customer            Customer?              @relation("CustomerUser")
  driver              Driver?                @relation("DriverUser")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ============================================
// CUSTOMERS & ACCOUNTS
// ============================================

model Customer {
  id             String   @id @default(cuid())
  accountId      String   @unique @default(cuid())
  name           String
  companyName    String?
  cnic           String?
  businessRef    String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  warehouse      String?  @default("LAHORE")
  accountType    String   @default("CUSTOMER")
  status         String   @default("ACTIVE")
  creditLimit    Float    @default(0)
  photo          String?
  notes          String?
  openingBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId                 String?  @unique
  user                   User?    @relation("CustomerUser", fields: [userId], references: [id])
  account                Account?
  consignmentsAsSender   Consignment[] @relation("Sender")
  consignmentsAsReceiver Consignment[] @relation("Receiver")
  consignmentsAsCustomer Consignment[] @relation("Customer")
  payments               Payment[]
  receivables            Receivable[]
  payables               Payable[]

  @@index([name])
  @@index([phone])
  @@index([city])
  @@index([accountType])
  @@index([status])
}

model Account {
  id             String   @id @default(cuid())
  accountNumber  String   @unique @default(cuid())
  accountName    String
  accountType    String   @default("CUSTOMER")
  openingBalance Float    @default(0)
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customerId   String?  @unique
  customer     Customer? @relation(fields: [customerId], references: [id])
  transactions AccountTransaction[]

  @@index([accountName])
  @@index([accountType])
}

model AccountTransaction {
  id            String   @id @default(cuid())
  accountId     String
  date          DateTime @default(now())
  voucherNumber String?
  description   String
  debit         Float    @default(0)
  credit        Float    @default(0)
  balance       Float    @default(0)
  paymentMethod String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([date])
  @@index([voucherNumber])
}

// ============================================
// CASH BOOKS (Strictly Separated)
// ============================================

model CashBook {
  id             String   @id @default(cuid())
  name           String
  city           String?
  description    String?
  openingBalance Float    @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions CashBookTransaction[]

  @@index([name])
  @@index([city])
  @@index([status])
}

model CashBookTransaction {
  id            String   @id @default(cuid())
  cashBookId    String
  date          DateTime @default(now())
  voucherNumber String?
  description   String
  accountPerson String?
  debit         Float    @default(0)
  credit        Float    @default(0)
  balance       Float    @default(0)
  paymentMethod String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cashBook  CashBook @relation(fields: [cashBookId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([cashBookId])
  @@index([date])
  @@index([voucherNumber])
  @@index([accountPerson])
}

// ============================================
// CONSIGNMENTS / BILTY
// ============================================

model Consignment {
  id                 String    @id @default(cuid())
  biltyNumber        String    @unique
  trackingId         String    @unique
  customerId         String?
  senderId           String?
  senderName         String?
  senderPhone        String?
  senderAddress      String?
  receiverId         String?
  receiverName       String?
  receiverPhone      String?
  receiverAddress    String?
  origin             String
  destination        String
  warehouse          String?   @default("LAHORE")
  vehicleId          String?
  vehicleNumber      String?
  driverId           String?
  driverName         String?
  packageDetails     String?
  quantity           Int       @default(1)
  weight             Float?
  cpm                Float?
  freight            Float     @default(0)
  additionalCharges  Float     @default(0)
  discount           Float     @default(0)
  totalAmount        Float     @default(0)
  paidAmount         Float     @default(0)
  remainingBalance   Float     @default(0)
  paymentStatus      String    @default("PENDING")
  shipmentStatus     String    @default("BOOKING_RECEIVED")
  date               DateTime  @default(now())
  deliveryDate       DateTime?
  deliveryTime       String?
  receivedBy         String?
  receiverConfirmation Boolean @default(false)
  deliveryNotes      String?
  notes              String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  challanId          String?
  challan            Challan?        @relation(fields: [challanId], references: [id])
  customer       Customer?       @relation("Customer", fields: [customerId], references: [id])
  sender         Customer?       @relation("Sender", fields: [senderId], references: [id])
  receiver       Customer?       @relation("Receiver", fields: [receiverId], references: [id])
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver         Driver?         @relation(fields: [driverId], references: [id])
  createdBy      User?           @relation("CreatedBy", fields: [createdById], references: [id])
  trackingEvents TrackingEvent[]
  payments       Payment[]

  @@index([biltyNumber])
  @@index([trackingId])
  @@index([customerId])
  @@index([senderId])
  @@index([receiverId])
  @@index([challanId])
  @@index([shipmentStatus])
  @@index([date])
}

model TrackingEvent {
  id            String   @id @default(cuid())
  consignmentId String
  status        String
  location      String?
  description   String?
  latitude      Float?
  longitude     Float?
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  consignment Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  @@index([consignmentId])
  @@index([status])
  @@index([timestamp])
}

// ============================================
// VEHICLES & DRIVERS
// ============================================

model Vehicle {
  id                  String    @id @default(cuid())
  vehicleNumber       String    @unique
  registrationNumber  String?
  vehicleType         String?
  make                String?
  model               String?
  year                Int?
  capacity            Float?
  ownerName           String?
  currentLocation     String?
  route               String?
  insuranceExpiry     DateTime?
  fitnessExpiry       DateTime?
  registrationDetails String?
  status              String    @default("AVAILABLE")
  documents           String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  driverId     String?
  driver       Driver?       @relation(fields: [driverId], references: [id])
  consignments Consignment[]
  challans     Challan[]

  @@index([vehicleNumber])
  @@index([vehicleType])
  @@index([status])
}

model Driver {
  id                 String    @id @default(cuid())
  name               String
  phone              String?
  contact            String?
  cnic               String?
  licenseNumber      String?
  licenseExpiry      DateTime?
  address            String?
  emergencyContact   String?
  vehicleNumber      String?
  assignedVehicleId  String?
  status             String    @default("AVAILABLE")
  photo              String?
  documents          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userId       String?   @unique
  user         User?     @relation("DriverUser", fields: [userId], references: [id])
  vehicles     Vehicle[]
  consignments Consignment[]
  challans     Challan[]

  @@index([name])
  @@index([phone])
  @@index([contact])
  @@index([status])
}

// ============================================
// CHALLANS / TRIP SETUP
// ============================================

model Challan {
  id                         String    @id @default(cuid())
  challanNumber              String    @unique
  date                       DateTime  @default(now())
  time                       String?
  truckNumber                String
  vehicleId                  String?
  driverId                   String?
  driverName                 String?
  driverPhone                String?
  brokerName                 String?
  routePermitNumber          String?
  origin                     String
  destination                String
  warehouse                  String?   @default("LAHORE")
  totalAmount                Float     @default(0)
  deliveryCommissionPercent  Float     @default(0)
  commissionDeduction        Float     @default(0)
  labourCost                 Float     @default(0)
  vehicleExpense             Float     @default(0)
  otherExpenses              Float     @default(0)
  estimatedProfit            Float     @default(0)
  status                     String    @default("IN_TRANSIT")
  arrivalDate                DateTime?
  arrivalTime                String?
  arrivalReceiver            String?
  arrivalNotes               String?
  deliveryNotes              String?
  notes                      String?
  createdById                String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  vehicle                    Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver                     Driver?   @relation(fields: [driverId], references: [id])
  consignments               Consignment[]

  @@index([challanNumber])
  @@index([status])
  @@index([warehouse])
  @@index([date])
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id            String   @id @default(cuid())
  type          String
  customerId    String?
  consignmentId String?
  cashBookId    String?
  amount        Float
  date          DateTime @default(now())
  paymentMethod String?
  reference     String?
  notes         String?
  status        String   @default("COMPLETED")
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer    Customer?    @relation(fields: [customerId], references: [id])
  consignment Consignment? @relation(fields: [consignmentId], references: [id])
  createdBy   User?        @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([type])
  @@index([customerId])
  @@index([consignmentId])
  @@index([date])
  @@index([status])
}

// ============================================
// RECEIVABLES & PAYABLES
// ============================================

model Receivable {
  id              String    @id @default(cuid())
  customerId      String
  description     String
  totalAmount     Float
  paidAmount      Float     @default(0)
  remainingAmount Float     @default(0)
  dueDate         DateTime?
  status          String    @default("PENDING")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model Payable {
  id              String    @id @default(cuid())
  vendorName      String?
  category        String    @default("OTHER")
  reference       String?
  vehicleNumber   String?
  driverName      String?
  customerId      String?
  description     String
  totalAmount     Float
  paidAmount      Float     @default(0)
  remainingAmount Float     @default(0)
  dueDate         DateTime?
  status          String    @default("UNPAID")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([category])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  recordId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([category])
}

// ============================================
// EXCEL IMPORTS
// ============================================

model ExcelImport {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileSize     Int?
  module       String
  totalRows    Int      @default(0)
  importedRows Int      @default(0)
  failedRows   Int      @default(0)
  status       String   @default("PENDING")
  errorLog     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([status])
}
